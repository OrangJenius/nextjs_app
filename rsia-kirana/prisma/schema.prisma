generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model appointments {
  id             Int       @id @default(autoincrement())
  patient_name   String
  phone          String
  email          String?
  doctor_id      String?   @db.Char(36)
  service_id     Int?
  user_id        Int?
  patient_id     Int?
  preferred_date DateTime  @db.Date
  preferred_time DateTime  @db.Time(6)
  notes          String?   @db.Text
  status         String    @default("pending")
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  doctors        doctors?  @relation(fields: [doctor_id], references: [id], onUpdate: NoAction)
  services       services? @relation(fields: [service_id], references: [id], onUpdate: NoAction)
  users          users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  patients       patients? @relation(fields: [patient_id], references: [id], onUpdate: NoAction)
}

model articles {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  content         String    @db.Text
  cover_image_url String?
  published_at    DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
}

model doctors {
  id               String             @id @default(uuid()) @db.Char(36)
  name             String
  specialization   String
  photo_url        String?
  bio              String?            @db.Text
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  category         String?
  appointments     appointments[]
  doctors_schedule doctors_schedule[]
}

model doctors_schedule {
  id          Int      @id @default(autoincrement())
  doctor_id   String   @db.Char(36)
  day_of_week Int      @db.SmallInt
  start_time  DateTime @db.Time(6)
  end_time    DateTime @db.Time(6)
  doctors     doctors  @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model services {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  description  String?        @db.Text
  icon_url     String?
  appointments appointments[]
}

model users {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  password     String
  phone        String?
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  patients     patients[]
  appointments appointments[]
}

model patients {
  id           Int            @id @default(autoincrement())
  user_id      Int
  nama_pasien  String
  nik          String
  no_hp        String
  email        String?
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments appointments[]

  @@index([user_id])
}